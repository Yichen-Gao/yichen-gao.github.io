---
import { navigation, site } from '../data/site';

const { currentPath } = Astro.props as { currentPath: string };
const pathOnly = (value: string) => {
  const normalized = value.split('#')[0] || '/';
  return normalized.endsWith('/') ? normalized : `${normalized}/`;
};
const isActive = (href: string) => {
  const current = pathOnly(currentPath || '/');
  const target = pathOnly(href);
  return target === '/' ? current === '/' : current.startsWith(target);
};
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/">
      <span class="brand__text">
        <strong>{site.nativeName}</strong>
        <small>{site.role}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a class={isActive(item.href) ? 'active' : ''} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
