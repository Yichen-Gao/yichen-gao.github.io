---
import { navigation, site } from '../data/site';

const { currentPath } = Astro.props as { currentPath: string };
const normalize = (value: string) => (value.endsWith('/') ? value : `${value}/`);
const isActive = (href: string) => {
  const current = normalize(currentPath || '/');
  const target = normalize(href);
  return target === '/' ? current === '/' : current.startsWith(target);
};
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/">
      <span class="brand__text">
        <strong>{site.nativeName}</strong>
        <small>{site.role}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a class={isActive(item.href) ? 'active' : ''} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
