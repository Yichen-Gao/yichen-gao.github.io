---
import LabLayout from '../../layouts/LabLayout.astro';
import type { ClusterData, StorageData, TrafficData } from '../../utils/lab';
import { loadLabJson, toPercent } from '../../utils/lab';

const clusterFallback: ClusterData = {
  updated_at: '待接入真实数据',
  sample_window: '最近 5 分钟',
  notes: [],
  nodes: [],
};

const storageFallback: StorageData = {
  updated_at: '待接入真实数据',
  reclaimable_estimate: '0 GiB',
  mountpoints: [],
  cleanup_candidates: [],
  stale_accounts: [],
  growth_hotspots: [],
  policies: [],
};

const trafficFallback: TrafficData = {
  updated_at: '待接入真实数据',
  month: '0000-00',
  quota_gb: 0,
  used_gb: 0,
  hard_limit_gb: 0,
  ignored_window: '00:00-06:00',
  alerts: [],
  users: [],
  spikes: [],
  rules: [],
};

const cluster = await loadLabJson<ClusterData>('cluster/latest.json', clusterFallback);
const storage = await loadLabJson<StorageData>('storage/latest.json', storageFallback);
const traffic = await loadLabJson<TrafficData>('traffic/latest.json', trafficFallback);

const fmt = (value: number, digits = 1) => value.toFixed(digits);

const nodeStatusLabel: Record<string, string> = {
  online: '在线',
  degraded: '紧张',
  offline: '离线',
};

const trafficStatusLabel: Record<string, string> = {
  ok: '正常',
  watch: '关注',
  limit: '受限',
  blocked: '已封',
};

const trafficStatusTone: Record<string, string> = {
  ok: 'info',
  watch: 'warn',
  limit: 'critical',
  blocked: 'critical',
};

const mounts = [...storage.mountpoints]
  .map((item) => ({
    ...item,
    percent: toPercent(item.used_tb, item.total_tb),
  }))
  .sort((a, b) => b.percent - a.percent);

const nodes = [...cluster.nodes].sort((a, b) => {
  const scoreA = toPercent(a.disk_used_tb, a.disk_total_tb) * 1000 + a.gpu_busy * 10 + a.cpu_used_pct;
  const scoreB = toPercent(b.disk_used_tb, b.disk_total_tb) * 1000 + b.gpu_busy * 10 + b.cpu_used_pct;
  return scoreB - scoreA;
});

const topTrafficUsers = [...traffic.users].sort((a, b) => b.used_gb - a.used_gb).slice(0, 8);
const recentSpikes = traffic.spikes.slice(0, 6);
const cleanupCandidates = storage.cleanup_candidates.slice(0, 8);

const onlineNodeCount = nodes.filter((item) => item.status !== 'offline').length;
const totalGpu = nodes.reduce((sum, item) => sum + item.gpu_count, 0);
const busyGpu = nodes.reduce((sum, item) => sum + item.gpu_busy, 0);
const totalGpuMemUsed = nodes.reduce((sum, item) => sum + item.gpu_mem_used_gb, 0);
const totalGpuMem = nodes.reduce((sum, item) => sum + item.gpu_mem_total_gb, 0);
const trafficRemaining = Math.max(0, traffic.quota_gb - traffic.used_gb);

const summaryItems = [
  ...mounts.slice(0, 3).map((item) => ({
    label: item.name,
    value: `${item.percent}%`,
    note: `${fmt(item.used_tb)} / ${fmt(item.total_tb)} TB`,
  })),
  {
    label: '本月流量',
    value: `${fmt(traffic.used_gb)} / ${fmt(traffic.quota_gb, 0)} GiB`,
    note: traffic.month,
  },
  {
    label: '剩余流量',
    value: `${fmt(trafficRemaining)} GiB`,
    note: `${traffic.ignored_window} 不计费`,
  },
  {
    label: '单人硬限制',
    value: `${fmt(traffic.hard_limit_gb, 0)} GiB`,
    note: '月内可放宽',
  },
  {
    label: '忙碌 GPU',
    value: `${busyGpu}/${totalGpu}`,
    note: `${onlineNodeCount}/${nodes.length} 节点在线`,
  },
  {
    label: '显存总占用',
    value: `${fmt(totalGpuMemUsed)} / ${fmt(totalGpuMem)} GiB`,
    note: cluster.sample_window,
  },
];
---

<LabLayout
  title="实验室管理总览 | 高一辰"
  description="实验室 GPU、磁盘与流量的高密度总览页。"
  section="overview"
  headline="实验室监控总览"
  intro="磁盘、流量、节点原始指标总览。"
  updatedAt={cluster.updated_at}
>
  <section class="lab-summary-strip lab-summary-strip--tight">
    {summaryItems.map((item) => (
      <article class="lab-summary-item">
        <span>{item.label}</span>
        <strong>{item.value}</strong>
        <small>{item.note}</small>
      </article>
    ))}
  </section>

  <section class="lab-priority-grid">
    <section class="lab-panel lab-panel--dense lab-panel--terminal">
      <div class="lab-panel__header lab-panel__header--tight">
        <div>
          <p class="eyebrow">Disk</p>
          <h2>磁盘占用</h2>
        </div>
        <a class="text-link" href="/lab/storage/">完整页</a>
      </div>

      <div class="lab-dense-split">
        <div class="lab-table-wrap">
          <table class="lab-table lab-table--dense lab-table--terminal">
            <thead>
              <tr>
                <th>挂载点</th>
                <th>主机</th>
                <th>已用 / 总量</th>
                <th>占用</th>
              </tr>
            </thead>
            <tbody>
              {mounts.map((item) => (
                <tr>
                  <td>{item.name}</td>
                  <td>{item.host}</td>
                  <td>{fmt(item.used_tb)} / {fmt(item.total_tb)} TB</td>
                  <td class={item.percent >= 95 ? 'lab-number-critical' : item.percent >= 85 ? 'lab-number-warn' : 'lab-number-ok'}>{item.percent}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="lab-table-wrap">
          <table class="lab-table lab-table--dense lab-table--terminal">
            <thead>
              <tr>
                <th>可清理项</th>
                <th>大小</th>
                <th>动作</th>
              </tr>
            </thead>
            <tbody>
              {cleanupCandidates.map((item) => (
                <tr>
                  <td>
                    <div class="lab-cell-title">{item.name}</div>
                    <div class="lab-cell-sub">{item.path}</div>
                  </td>
                  <td>{item.size}</td>
                  <td>{item.action}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="lab-panel lab-panel--dense lab-panel--terminal lab-traffic-panel">
      <div class="lab-panel__header lab-panel__header--tight">
        <div>
          <p class="eyebrow">Labflow</p>
          <h2>流量监控</h2>
        </div>
        <a class="text-link" href="/lab/traffic/">完整页</a>
      </div>

      <div class="lab-traffic-head">
        <div><span>Month</span><strong>{traffic.month}</strong></div>
        <div><span>Used</span><strong>{fmt(traffic.used_gb)} / {fmt(traffic.quota_gb, 0)} GiB</strong></div>
        <div><span>Remain</span><strong>{fmt(trafficRemaining)} GiB</strong></div>
        <div><span>Free</span><strong>{traffic.ignored_window}</strong></div>
        <div><span>Limit</span><strong>{fmt(traffic.hard_limit_gb, 0)} GiB</strong></div>
      </div>

      <div class="lab-table-wrap">
        <table class="lab-table lab-table--dense lab-table--terminal lab-table--mono">
          <thead>
            <tr>
              <th>#</th>
              <th>用户</th>
              <th>用量</th>
              <th>状态</th>
            </tr>
          </thead>
          <tbody>
            {topTrafficUsers.map((item, index) => (
              <tr>
                <td>{String(index + 1).padStart(2, '0')}</td>
                <td>{item.user}</td>
                <td>{fmt(item.used_gb)} GiB</td>
                <td>
                  <span class={`lab-pill lab-pill--${trafficStatusTone[item.status] ?? 'info'}`}>
                    {trafficStatusLabel[item.status] ?? item.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="lab-traffic-spikes">
        {recentSpikes.map((item) => (
          <div class="lab-traffic-spikes__row">
            <span>{item.time}</span>
            <strong>{item.user}</strong>
            <em>{item.size}</em>
          </div>
        ))}
      </div>
    </section>
  </section>

  <section class="lab-panel lab-panel--dense lab-panel--terminal">
    <div class="lab-panel__header lab-panel__header--tight">
      <div>
        <p class="eyebrow">Cluster</p>
        <h2>节点总览</h2>
      </div>
      <a class="text-link" href="/lab/cluster/">完整页</a>
    </div>

    <div class="lab-table-wrap">
      <table class="lab-table lab-table--dense lab-table--terminal lab-table--mono lab-node-grid-table">
        <thead>
          <tr>
            <th>节点</th>
            <th>状态</th>
            <th>磁盘</th>
            <th>GPU</th>
            <th>显存</th>
            <th>CPU</th>
            <th>RAM</th>
            <th>进程</th>
          </tr>
        </thead>
        <tbody>
          {nodes.map((node) => (
            <tr>
              <td>
                <div class="lab-cell-title">{node.label}</div>
                <div class="lab-cell-sub">{node.role}</div>
              </td>
              <td>
                <span class={`lab-pill lab-pill--${node.status === 'online' ? 'info' : node.status === 'degraded' ? 'warn' : 'critical'}`}>
                  {nodeStatusLabel[node.status] ?? node.status}
                </span>
              </td>
              <td class={toPercent(node.disk_used_tb, node.disk_total_tb) >= 95 ? 'lab-number-critical' : toPercent(node.disk_used_tb, node.disk_total_tb) >= 85 ? 'lab-number-warn' : 'lab-number-ok'}>
                {fmt(node.disk_used_tb)} / {fmt(node.disk_total_tb)} TB
                <div class="lab-cell-sub">{toPercent(node.disk_used_tb, node.disk_total_tb)}%</div>
              </td>
              <td>{node.gpu_busy}/{node.gpu_count}</td>
              <td>
                {fmt(node.gpu_mem_used_gb)} / {fmt(node.gpu_mem_total_gb)} GiB
                <div class="lab-cell-sub">{node.gpu_model}</div>
              </td>
              <td>{fmt(node.cpu_used_pct)}%</td>
              <td>{fmt(node.ram_used_gb)} / {fmt(node.ram_total_gb)} GiB</td>
              <td class="lab-table__wide">{node.top_processes?.[0] ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</LabLayout>
