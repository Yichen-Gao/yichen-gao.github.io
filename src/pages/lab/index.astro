---
import LabLayout from '../../layouts/LabLayout.astro';
import OverviewCard from '../../components/lab/OverviewCard.astro';
import type { ClusterData, DailyReportData, OverviewData, StorageData, TrafficData } from '../../utils/lab';
import { loadLabJson, toPercent } from '../../utils/lab';

const overviewFallback: OverviewData = {
  updated_at: '待接入真实数据',
  mode: 'fallback',
  metrics: [],
  alerts: [],
  highlights: [],
  top_users: [],
  top_nodes: [],
  next_steps: [],
};

const clusterFallback: ClusterData = {
  updated_at: '待接入真实数据',
  sample_window: '最近 5 分钟',
  notes: [],
  nodes: [],
};

const storageFallback: StorageData = {
  updated_at: '待接入真实数据',
  reclaimable_estimate: '0 GiB',
  mountpoints: [],
  cleanup_candidates: [],
  stale_accounts: [],
  growth_hotspots: [],
  policies: [],
};

const trafficFallback: TrafficData = {
  updated_at: '待接入真实数据',
  month: '0000-00',
  quota_gb: 0,
  used_gb: 0,
  hard_limit_gb: 0,
  ignored_window: '00:00-06:00',
  alerts: [],
  users: [],
  spikes: [],
  rules: [],
};

const dailyFallback: DailyReportData = {
  updated_at: '待接入真实数据',
  date: '0000-00-00',
  highlights: [],
  anomalies: [],
  actions: [],
};

const overview = await loadLabJson<OverviewData>('overview.json', overviewFallback);
const cluster = await loadLabJson<ClusterData>('cluster/latest.json', clusterFallback);
const storage = await loadLabJson<StorageData>('storage/latest.json', storageFallback);
const traffic = await loadLabJson<TrafficData>('traffic/latest.json', trafficFallback);
const daily = await loadLabJson<DailyReportData>('reports/daily.json', dailyFallback);

const nodes = cluster.nodes;
const rankedNodes = [...nodes].sort((a, b) => {
  const scoreA = a.gpu_busy * 100 + a.cpu_used_pct + a.ram_used_gb / 10;
  const scoreB = b.gpu_busy * 100 + b.cpu_used_pct + b.ram_used_gb / 10;
  return scoreB - scoreA;
});
const topNodes = rankedNodes.slice(0, 5);

const actionQueue = [
  ...overview.alerts.map((item) => ({
    level: item.level,
    title: item.title,
    note: item.detail,
    href: item.link ?? '/lab/',
  })),
  ...storage.cleanup_candidates.slice(0, 3).map((item) => ({
    level: item.risk === 'low' ? 'info' : 'warn',
    title: `${item.name} · ${item.action}`,
    note: `${item.size} · ${item.reason}`,
    href: '/lab/storage/',
  })),
  ...traffic.users
    .filter((item) => item.status === 'watch' || item.status === 'limit' || item.status === 'blocked')
    .slice(0, 3)
    .map((item) => ({
      level: item.status === 'limit' || item.status === 'blocked' ? 'critical' : 'warn',
      title: `${item.user} · ${item.used_gb} GiB`,
      note: item.note,
      href: '/lab/traffic/',
    })),
].slice(0, 8);

const trafficTopUsers = [...traffic.users].sort((a, b) => b.used_gb - a.used_gb).slice(0, 5);
const trafficRemaining = Math.max(0, traffic.quota_gb - traffic.used_gb);
const storageTopCandidates = storage.cleanup_candidates.slice(0, 4);
const storageTopMounts = [...storage.mountpoints]
  .map((item) => ({
    ...item,
    percent: toPercent(item.used_tb, item.total_tb),
  }))
  .sort((a, b) => b.percent - a.percent)
  .slice(0, 4);
const reportHighlights = daily.highlights.slice(0, 3);
const reportActions = daily.actions.slice(0, 3);

const heavyGpuRows = topNodes.map((node) => {
  const busiestGpu = [...(node.gpus ?? [])].sort((a, b) => b.memory_used_gb - a.memory_used_gb)[0];
  const topProcess = node.top_processes?.[0] ?? '当前没有活跃进程';
  return {
    node,
    busiestGpu,
    topProcess,
    gpuPercent: toPercent(node.gpu_mem_used_gb, node.gpu_mem_total_gb),
    ramPercent: toPercent(node.ram_used_gb, node.ram_total_gb),
    diskPercent: toPercent(node.disk_used_tb, node.disk_total_tb),
  };
});

const nodeStatusLabel: Record<string, string> = {
  online: '在线',
  degraded: '紧张',
  offline: '离线',
};

const levelLabel: Record<string, string> = {
  info: '提示',
  warn: '关注',
  critical: '高风险',
};

const trafficStatusLabel: Record<string, string> = {
  ok: '正常',
  watch: '关注',
  limit: '受限',
  blocked: '已封',
};

const onlineNodes = nodes.filter((item) => item.status !== 'offline');
const schedulableNodes = onlineNodes.filter((item) => item.gpu_count > 0 && !item.role.includes('登录'));
const bestNodeNow =
  [...schedulableNodes].sort((a, b) => {
    const freeGpuA = a.gpu_count - a.gpu_busy;
    const freeGpuB = b.gpu_count - b.gpu_busy;
    if (freeGpuA !== freeGpuB) return freeGpuB - freeGpuA;
    const freeMemA = a.gpu_mem_total_gb - a.gpu_mem_used_gb;
    const freeMemB = b.gpu_mem_total_gb - b.gpu_mem_used_gb;
    return freeMemB - freeMemA;
  })[0] ?? onlineNodes[0];

const mostConstrainedNode =
  [...onlineNodes].sort((a, b) => {
    const pressureA = toPercent(a.gpu_busy, Math.max(a.gpu_count, 1)) + toPercent(a.disk_used_tb, Math.max(a.disk_total_tb, 1));
    const pressureB = toPercent(b.gpu_busy, Math.max(b.gpu_count, 1)) + toPercent(b.disk_used_tb, Math.max(b.disk_total_tb, 1));
    return pressureB - pressureA;
  })[0] ?? nodes[0];

const topRiskUser =
  [...traffic.users].sort((a, b) => {
    const rank = { blocked: 4, limit: 3, watch: 2, ok: 1 };
    return (rank[b.status as keyof typeof rank] ?? 0) - (rank[a.status as keyof typeof rank] ?? 0) || b.used_gb - a.used_gb;
  })[0] ?? null;

const bestCleanup = storage.cleanup_candidates[0] ?? null;

const operatorAnswers = [
  bestNodeNow && {
    label: '现在最适合投任务',
    value: bestNodeNow.label,
    note: `${bestNodeNow.gpu_busy}/${bestNodeNow.gpu_count} 张 GPU 在忙，当前角色：${bestNodeNow.role}`,
    href: '/lab/cluster/',
    tone: 'teal',
  },
  mostConstrainedNode && {
    label: '现在先别继续塞',
    value: mostConstrainedNode.label,
    note: `GPU ${mostConstrainedNode.gpu_busy}/${mostConstrainedNode.gpu_count}，磁盘 ${toPercent(mostConstrainedNode.disk_used_tb, mostConstrainedNode.disk_total_tb)}%`,
    href: '/lab/cluster/',
    tone: 'rose',
  },
  topRiskUser && {
    label: '本月先盯这个人',
    value: `${topRiskUser.user} · ${topRiskUser.used_gb} GiB`,
    note: topRiskUser.note,
    href: '/lab/traffic/',
    tone: topRiskUser.status === 'ok' ? 'slate' : topRiskUser.status === 'watch' ? 'amber' : 'rose',
  },
  bestCleanup && {
    label: '最值得先回收',
    value: `${bestCleanup.name} · ${bestCleanup.size}`,
    note: bestCleanup.reason,
    href: '/lab/storage/',
    tone: bestCleanup.risk === 'low' ? 'amber' : 'slate',
  },
].filter(Boolean);
---

<LabLayout
  title="实验室管理总览 | 高一辰"
  description="实验室 GPU、磁盘、流量与日报的单页管理总览。"
  section="overview"
  headline="实验室运行面板"
  intro="这一页不再讲故事，直接给管理员最该看的信息：节点负载、显存热点、磁盘回收、流量风险和今天要做的动作。"
  updatedAt={overview.updated_at}
>
  <section class="lab-answer-grid">
    {operatorAnswers.map((item) => (
      <article class={`lab-answer-card tone-${item.tone}`}>
        <p class="lab-answer-card__label">{item.label}</p>
        <h2>{item.value}</h2>
        <p class="lab-answer-card__note">{item.note}</p>
        <a class="text-link" href={item.href}>展开查看</a>
      </article>
    ))}
  </section>

  <nav class="lab-jumpbar" aria-label="总览快速定位">
    <a href="#kpis">核心指标</a>
    <a href="#cluster">集群状态</a>
    <a href="#traffic">流量风险</a>
    <a href="#storage">磁盘动作</a>
    <a href="#today">今日处理</a>
  </nav>

  <section id="kpis" class="lab-section-grid lab-section-grid--stats lab-section-grid--stats-wide">
    {overview.metrics.map((item) => (
      <OverviewCard label={item.label} value={item.value} note={item.note} tone={item.tone} />
    ))}
  </section>

  <section class="lab-dashboard-grid">
    <section id="cluster" class="lab-panel lab-panel--dense">
      <div class="lab-panel__header">
        <div>
          <p class="eyebrow">集群状态</p>
          <h2>当前节点一览</h2>
        </div>
        <a class="text-link" href="/lab/cluster/">进入完整集群页</a>
      </div>

      <div class="lab-node-summary-grid">
        {heavyGpuRows.map(({ node, busiestGpu, topProcess, gpuPercent, ramPercent, diskPercent }) => (
          <article class={`lab-mini-node lab-mini-node--${node.status}`}>
            <div class="lab-mini-node__top">
              <div>
                <h3>{node.label}</h3>
                <p>{node.role}</p>
              </div>
              <span class={`lab-status lab-status--${node.status}`}>{nodeStatusLabel[node.status] ?? node.status}</span>
            </div>

            <div class="lab-mini-node__metrics">
              <div>
                <span>GPU</span>
                <strong>{node.gpu_busy}/{node.gpu_count}</strong>
              </div>
              <div>
                <span>CPU</span>
                <strong>{node.cpu_used_pct}%</strong>
              </div>
              <div>
                <span>RAM</span>
                <strong>{ramPercent}%</strong>
              </div>
              <div>
                <span>Disk</span>
                <strong>{diskPercent}%</strong>
              </div>
            </div>

            <div class="lab-mini-node__bars">
              <div>
                <div class="lab-mini-node__bar-label"><span>显存</span><strong>{node.gpu_mem_used_gb}/{node.gpu_mem_total_gb} GiB</strong></div>
                <div class="lab-meter__track"><span style={`width:${gpuPercent}%`}></span></div>
              </div>
              <div>
                <div class="lab-mini-node__bar-label"><span>最热 GPU</span><strong>{busiestGpu ? `GPU ${busiestGpu.index}` : '空闲'}</strong></div>
                <p class="lab-mini-node__process">{topProcess}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="lab-panel lab-panel--dense">
      <div class="lab-panel__header">
        <div>
          <p class="eyebrow">动作队列</p>
          <h2>管理员现在最该处理</h2>
        </div>
      </div>

      <div class="lab-action-stack">
        {actionQueue.map((item) => (
          <article class={`lab-action-card lab-action-card--${item.level}`}>
            <div class="lab-action-card__head">
              <h3>{item.title}</h3>
              <span class={`lab-pill lab-pill--${item.level}`}>{levelLabel[item.level] ?? item.level}</span>
            </div>
            <p>{item.note}</p>
            <a class="text-link" href={item.href}>查看对应页面</a>
          </article>
        ))}
      </div>
    </section>
  </section>

  <section class="lab-three-grid">
    <section id="traffic" class="lab-panel lab-panel--dense">
      <div class="lab-panel__header">
        <div>
          <p class="eyebrow">流量风险</p>
          <h2>本月额度与高风险用户</h2>
        </div>
        <a class="text-link" href="/lab/traffic/">进入流量页</a>
      </div>

      <div class="lab-slim-kpis">
        <article>
          <span>本月额度</span>
          <strong>{traffic.used_gb} / {traffic.quota_gb} GiB</strong>
          <small>{traffic.month}</small>
        </article>
        <article>
          <span>剩余</span>
          <strong>{trafficRemaining} GiB</strong>
          <small>{traffic.ignored_window} 不计费</small>
        </article>
        <article>
          <span>硬限制</span>
          <strong>{traffic.hard_limit_gb} GiB</strong>
          <small>支持管理员月内放宽</small>
        </article>
      </div>

      <div class="lab-list-compact">
        {trafficTopUsers.map((item) => (
          <article class="lab-list-compact__row">
            <div>
              <h3>{item.user}</h3>
              <p>{item.note}</p>
            </div>
            <div class="lab-list-compact__meta">
              <strong>{item.used_gb} GiB</strong>
              <span class={`lab-pill lab-pill--${item.status === 'ok' ? 'info' : item.status === 'watch' ? 'warn' : 'critical'}`}>{trafficStatusLabel[item.status] ?? item.status}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="storage" class="lab-panel lab-panel--dense">
      <div class="lab-panel__header">
        <div>
          <p class="eyebrow">磁盘动作</p>
          <h2>最值钱的回收与压力点</h2>
        </div>
        <a class="text-link" href="/lab/storage/">进入磁盘页</a>
      </div>

      <div class="lab-slim-kpis">
        <article>
          <span>可回收</span>
          <strong>{storage.reclaimable_estimate}</strong>
          <small>当前估计</small>
        </article>
        <article>
          <span>候选项</span>
          <strong>{storage.cleanup_candidates.length}</strong>
          <small>低风险 + 待复核</small>
        </article>
        <article>
          <span>最紧盘位</span>
          <strong>{storageTopMounts[0] ? `${storageTopMounts[0].percent}%` : '—'}</strong>
          <small>{storageTopMounts[0]?.name ?? '待接入'}</small>
        </article>
      </div>

      <div class="lab-list-compact lab-list-compact--dense">
        {storageTopCandidates.map((item) => (
          <article class="lab-list-compact__row">
            <div>
              <h3>{item.name}</h3>
              <p>{item.reason}</p>
            </div>
            <div class="lab-list-compact__meta">
              <strong>{item.size}</strong>
              <span class={`lab-pill lab-pill--${item.risk === 'low' ? 'info' : 'warn'}`}>{item.action}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="today" class="lab-panel lab-panel--dense">
      <div class="lab-panel__header">
        <div>
          <p class="eyebrow">今日处理</p>
          <h2>当天摘要与下一步</h2>
        </div>
        <a class="text-link" href="/lab/reports/">进入日报周报页</a>
      </div>

      <div class="lab-dual-list">
        <div>
          <h3>今日摘要</h3>
          <ul class="lab-muted-list lab-muted-list--tight">
            {reportHighlights.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3>立刻推进</h3>
          <ul class="lab-muted-list lab-muted-list--tight">
            {reportActions.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </section>
</LabLayout>
