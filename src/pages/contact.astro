---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="联系 | 高一辰" description="高一辰的联系方式。">
  <section class="shell content-page">
    <div class="section-heading section-heading--page">
      <div>
        <p class="eyebrow">联系</p>
        <h1>联系方式</h1>
      </div>
    </div>

    <div class="entry-list">
      {site.social.map((item) => (
        <article class="entry-card">
          <div class="entry-card__meta">
            <span>{item.label}</span>
          </div>
          <h3>{item.label}</h3>
          <p>{item.href.replace('mailto:', '')}</p>
          <a class="text-link" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
            打开链接
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
