---
import BaseLayout from '../layouts/BaseLayout.astro';
const resumeHref = '/files/resume.pdf';
---

<BaseLayout title="简历 PDF | 高一辰" description="高一辰的 PDF 简历。">
  <section class="shell content-page">
    <div class="section-heading section-heading--page">
      <div>
        <p class="eyebrow">简历</p>
        <h1>PDF 简历</h1>
      </div>
      <div class="section-actions">
        <a class="text-link" href={resumeHref} target="_blank" rel="noreferrer">新窗口打开</a>
        <a class="text-link" href={resumeHref} download>下载 PDF</a>
      </div>
    </div>

    <div class="pdf-frame">
      <iframe src={`${resumeHref}#view=FitH`} title="高一辰 PDF 简历"></iframe>
    </div>

    <p class="page-note">如果后续你有新的正式简历，只需要替换 `public/files/resume.pdf` 这个文件即可。</p>
  </section>
</BaseLayout>
