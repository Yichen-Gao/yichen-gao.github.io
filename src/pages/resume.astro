---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { skillGroups, strengths, timeline } from '../data/resume';
---

<BaseLayout title="简历 | 高一辰" description="适合招聘方快速浏览的中文简历页。">
  <section class="shell page-intro">
    <p class="eyebrow">简历页</p>
    <h1>给招聘方、面试官和合作方快速浏览的一页摘要。</h1>
    <p>{site.status}</p>
  </section>

  <section class="shell resume-grid">
    <div class="resume-block card">
      <p class="eyebrow">个人简介</p>
      <h2>{site.name} / {site.nativeName}</h2>
      <p>{site.intro}</p>
      <p>{site.location}</p>
    </div>

    <div class="resume-block card">
      <p class="eyebrow">优势</p>
      <div class="stack-list">
        {strengths.map((item) => (
          <div>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="shell resume-timeline">
    <div>
      <p class="eyebrow">经历脉络</p>
      <h2>把轨迹讲得更清楚，比堆信息更重要。</h2>
    </div>
    <div class="timeline-list">
      {timeline.map((item) => (
        <article class="timeline-item">
          <span>{item.period}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="shell skill-columns">
    {skillGroups.map((group) => (
      <article class="card">
        <p class="eyebrow">{group.title}</p>
        <ul class="bullet-list">
          {group.items.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    ))}
  </section>
</BaseLayout>
