---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found | Yichen Gao" description="Page not found.">
  <section class="shell page-intro not-found">
    <p class="eyebrow">404</p>
    <h1>That page moved, or never made the cut.</h1>
    <p>This site is intentionally lean. Head back to the homepage or jump into the projects archive.</p>
    <div class="hero__actions">
      <a class="button button--primary" href="/">Go home</a>
      <a class="button button--ghost" href="/projects/">Browse projects</a>
    </div>
  </section>
</BaseLayout>
