---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在 | 高一辰" description="页面不存在。">
  <section class="shell content-page">
    <div class="section-heading section-heading--page">
      <div>
        <p class="eyebrow">404</p>
        <h1>页面不存在</h1>
      </div>
    </div>
    <p class="page-note">你可以返回首页，或者直接查看项目和博客。</p>
    <div class="section-actions">
      <a class="text-link" href="/">返回首页</a>
      <a class="text-link" href="/projects/">查看项目</a>
      <a class="text-link" href="/blog/">查看博客</a>
    </div>
  </section>
</BaseLayout>
