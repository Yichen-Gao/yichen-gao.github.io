---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
---

<BaseLayout>
  <section class="hero shell section-grid">
    <div class="hero__copy">
      <p class="eyebrow">Open to opportunities</p>
      <h1>{site.intro}</h1>
      <p class="hero__lede">{site.status}</p>
      <p class="hero__body">{site.pitch}</p>

      <div class="hero__actions">
        <a class="button button--primary" href="/projects/">See selected work</a>
        <a class="button button--ghost" href="/resume/">Read the resume view</a>
      </div>

      <ul class="hero__focus" aria-label="Current focus">
        {site.focus.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <aside class="hero-panel">
      <p class="hero-panel__label">What this site is optimized for</p>
      <div class="hero-panel__metrics">
        {site.heroMetrics.map((metric) => (
          <div>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
      <div class="hero-panel__note">
        <p class="eyebrow">Positioning</p>
        <p>
          A recruiter or hiring manager should be able to understand your direction, strongest work, and writing style within
          a few minutes.
        </p>
      </div>
    </aside>
  </section>

  <section class="shell section-grid section-grid--tight">
    <div>
      <p class="eyebrow">Selected projects</p>
      <h2>Case studies that frame your work as engineering, not just coursework.</h2>
    </div>
    <a class="text-link text-link--top" href="/projects/">Browse all project cards</a>
  </section>

  <section class="shell card-grid">
    {featuredProjects.map((project) => <ProjectCard project={project} />)}
  </section>

  <section class="shell split-section">
    <div>
      <p class="eyebrow">Why this format works</p>
      <h2>More portfolio, less template.</h2>
    </div>
    <div class="split-section__content">
      <p>
        Instead of looking like an untouched academic homepage, this layout puts project framing, practical focus, and readable
        writing first. It is designed to support outreach, interviews, and resume links.
      </p>
      <p>
        The next step is simple: replace the weakest placeholder with a real case study that shows decisions, tradeoffs, and
        outcomes.
      </p>
    </div>
  </section>

  <section class="shell section-grid section-grid--tight">
    <div>
      <p class="eyebrow">Latest writing</p>
      <h2>Use short posts to show how you think, debug, and communicate.</h2>
    </div>
    <a class="text-link text-link--top" href="/blog/">Open the blog archive</a>
  </section>

  <section class="shell card-grid card-grid--posts">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
