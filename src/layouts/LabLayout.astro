---
import BaseLayout from './BaseLayout.astro';
import '../styles/lab.css';

interface Props {
  title: string;
  description: string;
  section: string;
  eyebrow?: string;
  headline: string;
  intro: string;
  updatedAt?: string;
}

const sections = [
  { key: 'overview', label: '总览', href: '/lab/' },
  { key: 'cluster', label: '集群', href: '/lab/cluster/' },
  { key: 'storage', label: '磁盘', href: '/lab/storage/' },
  { key: 'traffic', label: '流量', href: '/lab/traffic/' },
  { key: 'reports', label: '日报周报', href: '/lab/reports/' },
];

const {
  title,
  description,
  section,
  eyebrow = 'Lab Ops',
  headline,
  intro,
  updatedAt,
} = Astro.props;
---

<BaseLayout title={title} description={description} bodyClass="page--lab" hideHeader={true} hideFooter={true}>
  <section class="shell lab-shell">
    <header class="lab-topbar">
      <div class="lab-topbar__title">
        <p class="eyebrow">{eyebrow}</p>
        <div class="lab-topbar__headline-row">
          <h1>{headline}</h1>
          <span class="lab-topbar__badge">管理员视角</span>
        </div>
        <p class="lab-topbar__intro">{intro}</p>
      </div>
      <div class="lab-topbar__meta">
        <span>实验室统一监控页</span>
        <span>GPU / 流量 / 磁盘 / 日报</span>
        {updatedAt ? <span>最近刷新：{updatedAt}</span> : <span>最近刷新：待接入真实数据</span>}
      </div>
    </header>

    <nav class="lab-tabs lab-tabs--admin" aria-label="实验室监控导航">
      {sections.map((item) => (
        <a class={item.key === section ? 'active' : ''} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>

    <slot />
  </section>
</BaseLayout>
